<Window x:Class="RimworldDuplicateTexturesScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RimTexture Inspector" Height="920" Width="1220" MinHeight="700" MinWidth="900">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="190" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Scan the folder containing your Steam Workshop mod folders or local Mods folders." FontWeight="SemiBold" />
    <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,12">
      <Button DockPanel.Dock="Right" x:Name="ScanButton" Click="ScanButton_Click" Padding="20,6" Content="Scan texture paths" />
      <Button DockPanel.Dock="Right" x:Name="CancelButton" Click="CancelButton_Click" Padding="12,6" Margin="0,0,8,0" Content="Cancel" IsEnabled="False" />
      <Button DockPanel.Dock="Right" Click="BrowseButton_Click" Padding="12,6" Margin="0,0,8,0" Content="Browse…" />
      <TextBox x:Name="RootPathTextBox" VerticalContentAlignment="Center" ToolTip="One or more mod roots, separated with ;" />
    </DockPanel>
    <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Click="BrowseConfigButton_Click" Padding="12,6" Content="Browse config…" />
      <TextBox x:Name="ConfigPathTextBox" VerticalContentAlignment="Center" ToolTip="RimWorld ModsConfig.xml, used to limit scanning to active mods" />
    </DockPanel>
    <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,12">
      <TextBlock VerticalAlignment="Center" Text="Select a conflict, then use Ignore selected mod combination. Only an exact matching combination is hidden." TextWrapping="Wrap" />
    </DockPanel>
    <DockPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" x:Name="RemoveIgnoredCombinationButton" Click="RemoveIgnoredCombinationButton_Click" Padding="12,6" Content="Remove selected" IsEnabled="False" />
      <ListBox x:Name="IgnoredCombinationsListBox" Height="74" SelectionChanged="IgnoredCombinationsListBox_SelectionChanged" DisplayMemberPath="DisplayText" />
    </DockPanel>

    <GroupBox Grid.Row="5" Grid.Column="0" Header="Conflicting texture paths" Margin="0,0,8,0">
      <ListView x:Name="DuplicateGroups" SelectionChanged="DuplicateGroups_SelectionChanged">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Texture" Width="210" DisplayMemberBinding="{Binding DisplayName}" />
            <GridViewColumn Header="Copies" Width="55" DisplayMemberBinding="{Binding Copies.Count}" />
            <GridViewColumn Header="Mods" Width="240" DisplayMemberBinding="{Binding ModSummary}" />
          </GridView>
        </ListView.View>
      </ListView>
    </GroupBox>

    <GroupBox Grid.Row="5" Grid.Column="1" Header="Copies / preferred provider">
      <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ListBox x:Name="CopiesList" SelectionChanged="CopiesList_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="100" Height="100" BorderBrush="Gray" BorderThickness="1">
                  <Image Source="{Binding Preview}" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="{Binding ModName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PackageId}" Foreground="DimGray" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RelativePath}" Foreground="DimGray" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" Margin="0,8,0,0">
          <TextBlock x:Name="OrderHint" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Padding="12,5" Click="CopyHintButton_Click" Content="Copy RimSort order hint" />
            <Button x:Name="StageRuleButton" Margin="8,0,0,0" Padding="12,5" Click="StageRuleButton_Click" Content="Stage preferred mod after conflicts" IsEnabled="False" />
            <Button x:Name="IgnoreCombinationButton" Margin="8,0,0,0" Padding="12,5" Click="IgnoreCombinationButton_Click" Content="Ignore selected mod combination" IsEnabled="False" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </GroupBox>
    <TextBlock Grid.Row="6" Grid.ColumnSpan="2" x:Name="StatusText" Margin="0,10,0,0" Foreground="DimGray" />
    <GroupBox Grid.Row="7" Grid.ColumnSpan="2" Header="RimSort user rules" Margin="0,10,0,0">
      <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
          <Button DockPanel.Dock="Right" Padding="12,5" Click="ReloadRulesButton_Click" Content="Reload rules" />
          <TextBox x:Name="RulesFilePathTextBox" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="RimSort userRules.json file" />
        </DockPanel>
        <ListBox Grid.Row="1" x:Name="RulesListBox" DisplayMemberPath="DisplayText" SelectionChanged="RulesListBox_SelectionChanged" />
        <DockPanel Grid.Row="2" Margin="0,6,0,0">
          <Button DockPanel.Dock="Right" x:Name="SaveRulesButton" Padding="12,5" Click="SaveRulesButton_Click" Content="Save staged rules" IsEnabled="False" />
          <Button DockPanel.Dock="Right" x:Name="RemoveRuleButton" Margin="0,0,8,0" Padding="12,5" Click="RemoveRuleButton_Click" Content="Remove selected rule" IsEnabled="False" />
          <TextBlock x:Name="RulesStatusText" VerticalAlignment="Center" Foreground="DimGray" />
        </DockPanel>
      </Grid>
    </GroupBox>
  </Grid>
</Window>
