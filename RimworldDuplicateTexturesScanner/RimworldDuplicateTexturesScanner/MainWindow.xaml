<Window x:Class="RimworldDuplicateTexturesScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RimTexture Inspector" Height="920" Width="1220" MinHeight="700" MinWidth="900">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="190" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Scan enabled mods from your Steam Workshop library, local Mods folder, or both. At least one valid folder is required." FontWeight="SemiBold" TextWrapping="Wrap" />
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,12">
      <Button x:Name="ScanButton" Click="ScanButton_Click" Padding="20,6" Content="Scan for duplicates" />
      <Button x:Name="CancelButton" Click="CancelButton_Click" Padding="12,6" Margin="8,0,0,0" Content="Cancel" IsEnabled="False" />
    </StackPanel>
    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="108" /></Grid.ColumnDefinitions>
      <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,4" Text="Local Mods folder:" />
      <TextBox Grid.Row="1" x:Name="LocalModsPathTextBox" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="RimWorld local Mods folder; leave blank to exclude local mods" />
      <Button Grid.Row="1" Grid.Column="1" Click="BrowseLocalModsButton_Click" Padding="12,6" Content="Browse" />
    </Grid>
    <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="108" /></Grid.ColumnDefinitions>
      <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,4" Text="Steam Workshop folder:" />
      <TextBox Grid.Row="1" x:Name="WorkshopPathTextBox" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="Steam Workshop RimWorld content folder; leave blank to exclude Workshop mods" />
      <Button Grid.Row="1" Grid.Column="1" Click="BrowseWorkshopButton_Click" Padding="12,6" Content="Browse" />
    </Grid>
    <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="108" /></Grid.ColumnDefinitions>
      <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,4" Text="Active mods config:" />
      <TextBox Grid.Row="1" x:Name="ConfigPathTextBox" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="RimWorld ModsConfig.xml, used to limit scanning to active mods" />
      <Button Grid.Row="1" Grid.Column="1" Click="BrowseConfigButton_Click" Padding="12,6" Content="Browse" />
    </Grid>
    <DockPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,12">
      <TextBlock VerticalAlignment="Center" Text="Select a conflict, then use Ignore combination. Only an exact matching combination is hidden." TextWrapping="Wrap" />
    </DockPanel>
    <DockPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" x:Name="RemoveAllIgnoredCombinationsButton" Click="RemoveAllIgnoredCombinationsButton_Click" Padding="12,6" Content="Remove all conflicts" IsEnabled="False" />
      <Button DockPanel.Dock="Right" x:Name="RemoveIgnoredCombinationButton" Click="RemoveIgnoredCombinationButton_Click" Padding="12,6" Margin="0,0,8,0" Content="Remove selected conflicts" IsEnabled="False" />
      <ListBox x:Name="IgnoredCombinationsListBox" Height="74" SelectionMode="Extended" SelectionChanged="IgnoredCombinationsListBox_SelectionChanged" DisplayMemberPath="DisplayText" />
    </DockPanel>

    <GroupBox Grid.Row="7" Grid.Column="0" Header="Conflicting texture paths" Margin="0,0,8,0">
      <ListView x:Name="DuplicateGroups" SelectionChanged="DuplicateGroups_SelectionChanged">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Texture" Width="210" DisplayMemberBinding="{Binding DisplayName}" />
            <GridViewColumn Header="Copies" Width="55" DisplayMemberBinding="{Binding Copies.Count}" />
            <GridViewColumn Header="Mods" Width="240" DisplayMemberBinding="{Binding ModSummary}" />
          </GridView>
        </ListView.View>
      </ListView>
    </GroupBox>

    <GroupBox Grid.Row="7" Grid.Column="1" Header="Copies / preferred provider">
      <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ListBox x:Name="CopiesList" SelectionChanged="CopiesList_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="100" Height="100" BorderBrush="Gray" BorderThickness="1">
                  <Image Source="{Binding Preview}" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="{Binding ModName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PackageId}" Foreground="DimGray" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RelativePath}" Foreground="DimGray" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" Margin="0,8,0,0">
          <WrapPanel>
            <Button x:Name="StageRuleButton" Padding="12,5" Click="StageRuleButton_Click" Content="Stage preferred mod after conflicts" IsEnabled="False" />
            <Button x:Name="IgnoreCombinationButton" Margin="8,0,0,0" Padding="12,5" Click="IgnoreCombinationButton_Click" Content="Ignore combination" IsEnabled="False" />
          </WrapPanel>
        </StackPanel>
      </Grid>
    </GroupBox>
    <TextBlock Grid.Row="8" Grid.ColumnSpan="2" x:Name="StatusText" Margin="0,10,0,0" Foreground="DimGray" />
    <GroupBox Grid.Row="9" Grid.ColumnSpan="2" Header="RimSort user rules" Margin="0,10,0,0">
      <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,6">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="108" /></Grid.ColumnDefinitions>
          <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,4" Text="RimSort rules file:" />
          <TextBox Grid.Row="1" x:Name="RulesFilePathTextBox" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="RimSort userRules.json file" />
          <Button Grid.Row="1" Grid.Column="1" Padding="12,5" Click="BrowseRulesButton_Click" Content="Browse" />
        </Grid>
        <ListBox Grid.Row="1" x:Name="RulesListBox" SelectionMode="Extended" DisplayMemberPath="DisplayText" SelectionChanged="RulesListBox_SelectionChanged" />
        <Grid Grid.Row="2" Margin="0,6,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="RulesStatusText" VerticalAlignment="Center" Foreground="DimGray" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="ReloadRulesButton" Padding="12,5" Click="ReloadRulesButton_Click" Content="Reload rules" />
            <Button x:Name="RemoveAllRulesButton" Margin="8,0,0,0" Padding="12,5" Click="RemoveAllRulesButton_Click" Content="Remove all rules" IsEnabled="False" />
            <Button x:Name="RemoveRuleButton" Margin="8,0,0,0" Padding="12,5" Click="RemoveRuleButton_Click" Content="Remove selected rules" IsEnabled="False" />
            <Button x:Name="SaveRulesButton" Margin="8,0,0,0" Padding="12,5" Click="SaveRulesButton_Click" Content="Save staged rules" IsEnabled="False" />
          </StackPanel>
        </Grid>
      </Grid>
    </GroupBox>
  </Grid>
</Window>
